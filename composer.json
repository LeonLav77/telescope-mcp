{
    "name": "leonlav77/telescope-mcp",
    "description": "Minimal, read-only, key-protected MCP server for Laravel Telescope data.",
    "keywords": [
        "laravel",
        "telescope",
        "mcp",
        "model-context-protocol",
        "claude",
        "ai",
        "debugging",
        "observability"
    ],
    "homepage": "https://github.com/LeonLav77/telescope-mcp",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LeonLav77",
            "email": "leonlav77@gmail.com",
            "homepage": "https://github.com/LeonLav77"
        }
    ],
    "support": {
        "issues": "https://github.com/LeonLav77/telescope-mcp/issues",
        "source": "https://github.com/LeonLav77/telescope-mcp"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "laravel/mcp": "^1.0",
        "laravel/telescope": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.0"
    },
    "autoload": {
        "psr-4": {
            "LloydsDigital\\TelescopeMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LloydsDigital\\TelescopeMcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LloydsDigital\\TelescopeMcp\\TelescopeMcpServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
